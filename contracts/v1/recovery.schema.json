{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recovery Result Schema v1",
  "type": "object",
  "required": [
    "job_id",
    "case_id",
    "evidence_id",
    "artifacts_recovered",
    "artifacts_validated",
    "engines_run",
    "duration_ms"
  ],
  "properties": {
    "job_id": { "type": "string", "format": "uuid" },
    "case_id": { "type": "string", "format": "uuid" },
    "evidence_id": { "type": "string", "format": "uuid" },
    "artifacts_recovered": { "type": "integer", "minimum": 0 },
    "artifacts_validated": { "type": "integer", "minimum": 0 },
    "engines_run": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["engine_name", "status"],
        "properties": {
          "engine_name": { "type": "string" },
          "engine_version": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "running", "success", "failed", "skipped"] },
          "duration_ms": { "type": "integer" }
        }
      }
    },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}