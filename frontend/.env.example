# TRACE X — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.

# ─────────────────────────────────────────────────
# API / Backend URL
# For Vercel deployments, set this to the URL of
# your deployed backend API (if any).
# Leave empty to run in web-only / demo mode.
# ─────────────────────────────────────────────────
VITE_API_URL=

# ─────────────────────────────────────────────────
# Mode flags
# Set to "true" to enable verbose console logging.
# ─────────────────────────────────────────────────
VITE_DEBUG=false
