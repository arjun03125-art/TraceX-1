# Forensic Recovery Platform - Environment Configuration

# Application
APP_NAME="Forensic Recovery Platform"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (SQLite for development, PostgreSQL for production)
# Production: postgresql+asyncpg://user:pass@localhost:5432/forensic
DATABASE_URL=sqlite+aiosqlite:///./data/forensic.db

# Redis (for Celery queue) - disabled for dev, use in-memory queue
# REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache://

# Security
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Evidence Storage
EVIDENCE_ROOT_PATH=./evidence
MAX_UPLOAD_SIZE=10737418240  # 10GB

# Forensic Engines (paths to external tools)
XFS_TOOL_PATH=
BTRFS_TOOL_PATH=
CARVING_TOOL_PATH=
SLEUTHKIT_PATH=

# Reporting
REPORT_OUTPUT_PATH=./evidence/reports

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000